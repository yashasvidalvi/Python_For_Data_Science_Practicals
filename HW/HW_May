salary = [67000,45000,78000,55000,28000]

#min salary
min_salary = salary[0]
for s in salary:
    if s < min_salary:
        min_salary = s
print(min_salary)

#max salary
max_salary = salary[0]
for s in salary:
    if s > max_salary:
        max_salary = s
print(max_salary)

#Average salary
total = 0
for s in salary:
    total = total + s
average = total/len(salary)
print(average)
